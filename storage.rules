rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // 일지 사진: babies/{babyId}/notes/{noteId}/photos/{photoId}
    match /babies/{babyId}/notes/{noteId}/photos/{photoId} {
      allow read: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/babies/$(babyId)).data.caregiverIDs;

      allow write: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/babies/$(babyId)).data.caregiverIDs
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/babies/$(babyId)).data.caregiverIDs;
    }

    // 아기 프로필 사진: babies/{babyId}/profile/{photoId}
    match /babies/{babyId}/profile/{photoId} {
      allow read: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/babies/$(babyId)).data.caregiverIDs;

      allow write: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/babies/$(babyId)).data.caregiverIDs
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/babies/$(babyId)).data.caregiverIDs;
    }
  }
}
